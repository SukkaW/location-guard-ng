{
  "name": "location-guard-ng-monorepo",
  "version": "0.2.4",
  "private": true,
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "turbo build",
    "typecheck": "tsc --build --noEmit",
    "prerelease": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "release": "bumpp --install -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "devDependencies": {
    "@eslint-sukka/react": "^8.13.5",
    "bumpp": "^10.4.1",
    "eslint": "^10.7.0",
    "eslint-config-sukka": "^8.13.5",
    "eslint-formatter-sukka": "^8.13.5",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.12.0"
}
